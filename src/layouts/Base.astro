---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="/images/hero.jpg" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital@1&family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<Icons />
<Header />
<slot />
<Footer />
<script is:inline>

const n=document.getElementById('nav'),b=document.getElementById('bu'),dd=document.querySelector('.dd'),db=dd.querySelector('button');
const mob=()=>matchMedia('(max-width:1080px)').matches;
function shut(){n.classList.remove('o');b.textContent='☰';b.setAttribute('aria-expanded','false');b.setAttribute('aria-label','Abrir menu');b.style.cssText='';dd.classList.remove('open');db.setAttribute('aria-expanded','false')}
b.onclick=()=>{const o=n.classList.toggle('o');b.setAttribute('aria-expanded',o);b.setAttribute('aria-label',o?'Fechar menu':'Abrir menu');b.textContent=o?'✕':'☰';b.style.cssText=o?'position:fixed;right:12px;top:14px;z-index:130':''};
db.onclick=()=>{if(mob())return;const o=dd.classList.toggle('open');db.setAttribute('aria-expanded',o)};
dd.addEventListener('mouseenter',()=>{if(!mob()){dd.classList.add('open');db.setAttribute('aria-expanded','true')}});
dd.addEventListener('mouseleave',()=>{if(!mob()){dd.classList.remove('open');db.setAttribute('aria-expanded','false')}});
n.onclick=e=>{if(e.target.closest('a'))shut()};
document.addEventListener('click',e=>{if(!dd.contains(e.target)&&!mob()){dd.classList.remove('open');db.setAttribute('aria-expanded','false')}});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){const was=dd.classList.contains('open');shut();(was?db:b).focus()}});
addEventListener('resize',()=>{if(!mob())shut()});



</script>
</body>
</html>
