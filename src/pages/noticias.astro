---
import Base from '../layouts/Base.astro';
---
<Base
  title="Notícias — Instituto Brasileiro Dresbach"
  description="Notícias e atualizações do Instituto Brasileiro Dresbach"
>
<main id="top">
  <section class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h1 class="text-3xl font-bold text-navy mb-6">Notícias</h1>
      <p class="text-lg text-gray-600 mb-6">
        As últimas notícias e atualizações do Instituto Brasileiro Dresbach.
      </p>

      <section className="bg-white py-8">
        <div className="max-w-7xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-6">
          <article className="bg-white rounded-lg p-6 hover:bg-gray-50 transition-colors">
            <div className="flex items-start gap-4">
              <div className="bg-orange-500 text-white text-xs font-medium uppercase tracking-wider mb-2">2024</div>
              <div>
                <h3 className="text-orange-500 hover:text-navy transition-colors">Novo edital de pesquisa publicado</h3>
                <p className="text-gray-500 text-sm">15/01/2024 | Mais informações</p>
              </div>
            </div>
            <article className="bg-white rounded-lg p-6 hover:bg-gray-50 transition-colors">
              <div className="flex items-start gap-4">
                <div className="bg-orange-500 text-white text-xs font-medium uppercase tracking-wider mb-2">2024</div>
                <div>
                  <h3 className="text-orange-500 hover:text-navy transition-colors">Cultura alemã em destaque</h3>
                  <p className="text-gray-500 text-sm">05/01/2024 | Mais informações</p>
                </div>
              </div>
            </article>
            <article className="bg-white rounded-lg p-6 hover:bg-gray-50 transition-colors">
              <div className="flex items-start gap-4">
                <div className="bg-orange-500 text-white text-xs font-medium uppercase tracking-wider mb-2">2023</div>
                <div>
                  <h3 className="text-orange-500 hover:text-navy transition-colors">Memória Wittgenstein atualizada</h3>
                  <p className="text-gray-500 text-sm">20/12/2023 | Mais informações</p>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section className="py-8 bg-gray-100">
        <div className="max-w-7xl mx-auto px-4">
          <p className="text-gray-500 text-sm">
            Mais notícias disponíveis quando o sistema de conteúdo estiver conectado.
          </p>
        </div>
      </section>
    </div>
  </section>
</main>
</Base>