---
import Base from '../layouts/Base.astro';
---
<Base
  title="Entrar — Instituto Brasileiro Dresbach"
  description="Página de autenticação e login do Instituto Brasileiro Dresbach"
>
<main id="top">
  <section class="min-h-screen bg-gray-50 flex items-center justify-center">
    <div class="bg-white rounded-lg p-8 max-w-md w-full shadow-lg">
      <h2 class="text-2xl font-bold text-navy text-center mb-6">Entrar na Área</h2>

      <form class="space-y-4">
        <div>
          <label className="block text-sm font-medium text-gray-700 mb-2">
            <span className="text-gray-500">E-mail</span>
            <input
              type="email"
              name="email"
              required
              className="w-full rounded-lg border border-gray-300 p-3 focus:ring-2 focus:ring-orange-500 focus-visible:outline-none"
              placeholder="seu@email.com"
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">
              <span className="text-gray-500">Senha</span>
              <input
                type="password"
                name="password"
                required
                className="w-full rounded-lg border border-gray-300 p-3 focus:ring-2 focus:ring-orange-500 focus-visible:outline-none"
                placeholder="Sua senha"
              />
            </label>
          </div>

          <button
            type="submit"
            className="w-full bg-orange-600 text-white font-medium py-3 rounded-lg hover:bg-orange-500 transition-colors"
          >
            Entrar
          </button>
        </form>

        <div className="mt-6 text-center">
          <p className="text-sm text-gray-500">
            Não tem uma conta? <a href="/participe/seja-membro" className="text-orange-600 font-medium hover:underline">Cadastre-se</a>
          </p>
        </div>
      </section>
    </div>
  </section>
</main>
</Base>