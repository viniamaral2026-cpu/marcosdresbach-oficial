import Base from '../layouts/Base.astro';
---
<Base title="Marcos Dresbach | Política, Propósito e Compromisso" description="Conheça a trajetória, as propostas e os projetos de Marcos Dresbach, com foco em políticas públicas, Saúde Única, participação cidadã e desenvolvimento regional.">
<main id="top">
<section class="hero"><div class="ph" role="img" aria-label="Retrato de Marcos Dresbach ao pôr do sol"></div>
<div class="w"><div><div class="eb">Trabalho, liberdade e responsabilidade</div>
<h1>POR UM BRASIL <span>MAIS FORTE</span></h1>
<p class="l">Políticas públicas eficientes, respeito ao cidadão, defesa da vida, da propriedade e da liberdade. Compromisso com as pessoas, os animais e as comunidades.</p>
<div class="row"><a class="btn" href="#saude">Conheça minhas propostas <svg><use href="#ar"/></svg></a><a class="btn wh" href="/contato">Fale comigo <svg><use href="#ar"/></svg></a></div></div>
<div class="q">“Política de verdade é serviço às pessoas.”<hr><b>Marcos Dresbach</b></div></div></section>

<div class="w pil" id="propostas">
<div><svg><use href="#users"/></svg><h3>PESSOAS</h3><p>Qualidade de vida, segurança, saúde e oportunidades.</p></div>
<div><svg><use href="#paw"/></svg><h3>ANIMAIS</h3><p>Proteção, bem-estar e saúde pública.</p></div>
<div><svg><use href="#leaf"/></svg><h3>AMBIENTE</h3><p>Cidades mais saudáveis e sustentáveis.</p></div>
<div><svg><use href="#chart"/></svg><h3>GESTÃO EFICIENTE</h3><p>Transparência, responsabilidade e menos desperdício.</p></div>
<div><svg><use href="#shield"/></svg><h3>LIBERDADE</h3><p>Respeito ao cidadão, trabalho e desenvolvimento.</p></div></div>

<section id="sobre" style="padding:56px 0 8px"><div class="w" style="max-width:820px"><div class="eb">Sobre</div><h2>Política com propósito, participação e compromisso.</h2><p style="color:#374151;margin-bottom:12px">Marcos Dresbach é uma liderança política em construção, com atuação voltada a políticas públicas, participação cidadã e causas sociais, como a Saúde Única e a causa animal.</p><p style="color:#374151">Declara alinhamento com princípios do Partido NOVO e atua no Instituto Brasileiro Dresbach, dedicado à preservação da cultura alemã e da memória histórica.</p><a class="btn ol" href="/sobre" style="margin-top:18px">Leia a história completa <svg><use href="#ar"/></svg></a></div></section>
<section class="sp" id="saude"><div class="im" style="background-image:url(/images/pets.jpg)" role="img" aria-label="Cachorro e gato juntos"></div>
<div class="tx"><div class="pj"><div><div class="eb">Projeto em destaque</div><h2>Política Nacional de Saúde Única e Zoonoses</h2>
<p style="font-size:.88rem;margin-bottom:14px">Uma proposta completa para integrar saúde humana, animal e ambiental, com foco na prevenção, no controle de zoonoses, no bem-estar animal e na proteção das comunidades.</p>
<ul class="ck"><li><svg><use href="#ok"/></svg>Assistência veterinária de interesse público</li><li><svg><use href="#ok"/></svg>Vigilância integrada e controle ambiental</li><li><svg><use href="#ok"/></svg>Proteção da saúde das pessoas e dos animais</li><li><svg><use href="#ok"/></svg>Impacto real para os municípios e regiões</li></ul>
<div class="row"><a class="btn" href="/contato">Conheça o projeto completo <svg><use href="#ar"/></svg></a><a class="btn ol" href="/contato"><svg><use href="#file"/></svg>Baixar proposta (PDF)</a></div></div>
<div class="cs"><div><svg><use href="#heart"/></svg><span><b>Prevenção Salva Vidas</b>Menos doenças para pessoas e animais.</span></div><div><svg><use href="#users"/></svg><span><b>Cidades Mais Saudáveis</b>Ambiente, pessoas e animais em equilíbrio.</span></div><div><svg><use href="#chart"/></svg><span><b>Desenvolvimento Regional</b>Soluções técnicas e sustentáveis.</span></div></div></div></div></section>

<section class="sp rv" id="politica" style="background:#fff"><div class="im fade" style="background-image:url(/images/flag.jpg)" role="img" aria-label="Marcos Dresbach diante da bandeira do Brasil"></div>
<div class="tx"><div class="pj"><div><div class="eb">Alinhamento político</div><h2>Por um Brasil de mais liberdade e oportunidades</h2>
<p style="font-size:.88rem;margin-bottom:18px">Sou alinhado ao Partido NOVO, que defende uma política limpa, eficiente e voltada para o cidadão. Acredito em um Estado enxuto, transparente e que entregue resultados reais para a sociedade.</p>
<a class="btn" href="#participe">Conheça minha visão política <svg><use href="#ar"/></svg></a> <a class="btn ol" href="#filie" style="margin-top:10px">Filie-se ao NOVO</a></div>
<div><div class="novo">NOVO<small>LIBERDADE · RESPEITO<br>OPORTUNIDADES</small></div><div class="bx"><ul class="ck"><li><svg><use href="#ok"/></svg>Estado eficiente</li><li><svg><use href="#ok"/></svg>Menos burocracia</li><li><svg><use href="#ok"/></svg>Mais oportunidades</li><li><svg><use href="#ok"/></svg>Respeito ao cidadão</li><li><svg><use href="#ok"/></svg>Transparência</li></ul></div></div></div></div></section>

<section class="ins" id="instituto"><div class="cr"><img src="/images/crest.jpg" alt="Brasão do Instituto Brasileiro Dresbach, Taquara RS, desde 1644" width="120" height="120"><div><em>INSTITUTO BRASILEIRO</em>DRESBACH<small>PRESERVAÇÃO DA CULTURA ALEMÃ,<br>PESQUISA HISTÓRICA E MEMÓRIA WITTGENSTEIN</small></div></div>
<div class="bd"><div><div class="eb" style="font-size:.62rem">Cultura, história e comunidade</div><h2>Instituto Brasileiro Dresbach</h2><p>Preservação da cultura alemã, pesquisa histórica e memória, com ações sociais e apoio a iniciativas locais, incluindo o bem-estar animal e o desenvolvimento comunitário.</p><a class="btn ol" href="/instituto" style="min-height:40px;padding:8px 18px">Conheça o Instituto <svg><use href="#ar"/></svg></a> <a class="btn" href="#doe" style="min-height:40px;padding:8px 18px">Apoie o Instituto</a></div><div class="hs" role="img" aria-label="Casa em estilo enxaimel"></div></div></section>

<section class="doe" id="doe"><div class="w dg"><div>
<div class="eb">Apoie o Instituto</div><h2>Ajude a preservar a nossa história.</h2>
<p>O Instituto Brasileiro Dresbach nasceu do propósito de preservar a memória da família Dresbach e da cultura alemã no Brasil, com pesquisa histórica, genealogia, documentação e educação. É um trabalho de longo prazo, que só se sustenta com o apoio de pessoas que acreditam na importância da memória e da identidade.</p>
<p>Sua doação ajuda a manter essa história viva e acessível para as próximas gerações.</p>
<h3>Para onde vai a sua doação</h3>
<ul class="ck"><li><svg><use href="#ok"/></svg>Pesquisa histórica e genealogia</li><li><svg><use href="#ok"/></svg>Documentação e digitalização de acervo</li><li><svg><use href="#ok"/></svg>Preservação do patrimônio e da memória regional</li><li><svg><use href="#ok"/></svg>Educação e divulgação da cultura alemã</li></ul>
<h3>Como prestamos contas</h3>
<ul class="ck"><li><svg><use href="#ok"/></svg>Toda doação recebida é registrada.</li><li><svg><use href="#ok"/></svg>A prestação de contas é publicada aqui, nesta página, com o que foi recebido e como foi aplicado.</li><li><svg><use href="#ok"/></svg>Os recursos são destinados às finalidades do Instituto, descritas acima.</li></ul>
</div>
<aside class="pix" aria-labelledby="pxh"><h3 id="pxh">Doe por Pix</h3><p style="margin:0;font-size:.9rem;color:var(--gr)">Qualquer valor ajuda.</p>
<span class="lb">Favorecido</span><span class="vl">DEEVO Soluções Financeiras LTDA</span>
<span class="lb">CNPJ (chave Pix)</span><span class="vl" id="cnpj">63.187.175/0001-70</span>
<button class="btn" type="button" id="cp"><svg><use href="#file"/></svg><span>Copiar chave Pix</span></button>
<small role="status" id="cps">Confira o nome do favorecido no seu aplicativo antes de confirmar o pagamento.</small></aside></div></section>
<section class="fil" id="filie"><div class="w"><div class="eb">Faça parte</div><h2>Venha fazer parte dessa mudança.</h2>
<p>Se você está comprometido com a causa e tem os mesmos valores e princípios que eu — liberdade, responsabilidade, transparência e respeito ao cidadão —, eu convido você: venha se filiar ao Partido NOVO.</p>
<a class="btn" href="https://novo.org.br/filiacao/?hash=copy" target="_blank" rel="noopener">FILIE-SE AO PARTIDO NOVO <svg><use href="#ar"/></svg></a>
<small>A filiação é feita diretamente no site do Partido NOVO. Este site não é o site oficial do partido.</small></div></section>
<section class="pt" id="participe"><div class="w"><div class="eb">Você também pode fazer parte</div><h2>Vamos construir isso juntos</h2><p class="sub">Apoie, compartilhe, participe e ajude a transformar essa causa em realidade.</p>
<div class="g4"><a href="/contato"><svg><use href="#heart"/></svg><span><b>Apoie a causa animal</b>Seja um voluntário, parceiro ou doador.</span><svg><use href="#ar"/></svg></a><a href="/contato"><svg><use href="#users"/></svg><span><b>Participe da comunidade</b>Divulgue, informe e engaje mais pessoas.</span><svg><use href="#ar"/></svg></a><a href="#saude"><svg><use href="#file"/></svg><span><b>Acompanhe o projeto</b>Receba atualizações e novidades.</span><svg><use href="#ar"/></svg></a><a href="/contato"><svg><use href="#chat"/></svg><span><b>Entre em contato</b>Envie sua sugestão, relato ou proposta.</span><svg><use href="#ar"/></svg></a></div></div></section>
</main>
<script is:inline>
document.getElementById('cp').onclick=async()=>{const t='63.187.175/0001-70',m=document.getElementById('cps');try{await navigator.clipboard.writeText(t);m.textContent='Chave Pix copiada: '+t}catch(e){const r=document.createRange();r.selectNodeContents(document.getElementById('cnpj'));const x=getSelection();x.removeAllRanges();x.addRange(r);m.textContent='Selecione e copie a chave: '+t}};

