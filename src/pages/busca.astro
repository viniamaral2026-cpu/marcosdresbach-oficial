---
import Base from '../layouts/Base.astro';
---
<Base
  title="Busca — Instituto Brasileiro Dresbach"
  description="Busca no acervo, genealogia, pesquisa e publicações do Instituto Brasileiro Dresbach"
>
<main id="top">
  <section class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h1 class="text-3xl font-bold text-navy mb-6">Busca</h1>
      <p class="text-lg text-gray-600 mb-6">
        Busque no acervo, genealogia, pesquisa e publicações do Instituto Brasileiro Dresbach.
      </p>

      <section className="bg-white py-8">
        <div className="max-w-7xl mx-auto px-4">
          <div className="border-b border-gray-200 pb-6">
            <h1 className="text-3xl font-extrabold text-navy">Busca</h1>
            <p className="mt-2 text-lg text-gray-600">
                Digite o que deseja pesquisar no acervo, genealogia, pesquisa ou publicações.
            </p>
          </div>

          {/* Search Form */}
          <div className="mt-8 grid max-w-2xl">
            <div className="rounded-lg border border-gray-300 p-4">
              <svg className="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" d="M21 21l-5.2-5.2a1.93 1.93 0 01-2.83 0L10 14.2m8.6 8.6l5.2 5.2a1.93 1.93 0 010 2.83l-5.2-5.2a1.93 1.93 0 01-2.83 0L3.427 20.9"></path>
              </svg>
              <input
                type="text"
                placeholder="Digite o que deseja pesquisar..."
                className="w-full bg-white py-2 px-3 rounded-lg focus:ring-2 focus:ring-orange-500 focus-visible:outline-none disabled:bg-gray-100 disabled:cursor-not-placeholder"
                aria-label="Digite o que deseja pesquisar"
              />
            </div>
          </div>

          {/* Search Filters */}
          <div className="mt-8 grid grid-cols-2 gap-4">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                <span className="select-span">Tipo</span>
                <select className="w-full rounded-lg border border-gray-300 p-2 focus:ring-2 focus:ring-orange-500 focus-visible:outline-none">
                  <option>Todos</option>
                  <option>Acervo</option>
                  <option>Genealogia</option>
                  <option>Pesquisa</option>
                  <option>Editora</option>
                </select>
              </label>
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                <span className="select-span">Período</span>
                <select className="w-full rounded-lg border border-gray-300 p-2 focus:ring-2 focus:ring-orange-500 focus-visible:outline-none">
                  <option>Todos</option>
                  <option>2024</option>
                  <option>2023</option>
                  <option>Anterior</option>
                </select>
              </label>
            </div>
          </div>
        </div>
      </section>

      <section className="py-8 bg-gray-100">
        <div className="max-w-7xl mx-auto px-4">
          <p className="text-gray-500 text-sm">
            Os resultados da busca aparecerão aqui quando o sistema estiver conectado.
          </p>
        </div>
      </section>
    </div>
  </section>
</main>
</Base>