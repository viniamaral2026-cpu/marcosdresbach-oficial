---
import Base from '../layouts/Base.astro';
---
<Base
  title="Editais — Instituto Brasileiro Dresbach"
  description="Editais e chamadas públicas do Instituto Brasileiro Dresbach"
>
<main id="top">
  <section class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h1 class="text-3xl font-bold text-navy mb-6">Editais</h1>
      <p class="text-lg text-gray-600 mb-6">
        Editais e chamadas públicas para projetos, pesquisadores, voluntários e
        contribuintes do Instituto Brasileiro Dresbach.
      </p>

      <section className="bg-white py-8">
        <div className="max-w-7xl mx-auto px-4">
          <div className="border-b border-gray-200 pb-6">
            <h1 className="text-3xl font-extrabold text-navy">Editais</h1>
            <p className="mt-2 text-lg text-gray-600">
                Chamadas públicas para projetos, pesquisadores, voluntários e contribuintes.
            </p>
          </div>

          {/* Filters */}
          <div className="mt-8 grid grid-cols-2 gap-4">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                <span className="select-span">Tipo</span>
                <select className="w-full rounded-lg border border-gray-300 p-2 focus:ring-2 focus:ring-orange-500 focus-visible:outline-none">
                  <option>Todos</option>
                  <option>Pesquisa</option>
                  <option>Voluntariado</option>
                  <option>Doação</option>
                </select>
              </label>
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                <span className="select-span">Ano</span>
                <select className="w-full rounded-lg border border-gray-300 p-2 focus:ring-2 focus:ring-orange-500 focus-visible:outline-none">
                  <option>Todos</option>
                  <option>2024</option>
                  <option>2023</option>
                </select>
              </label>
            </div>
          </div>
        </div>
      </section>

      <section className="bg-white py-8">
        <div className="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <!-- Example edital cards -->
          <div className="bg-gray-50 rounded-lg p-6 border border-dashed border-gray-300 hover:bg-white transition-colors">
            <h3 className="text-orange-500 text-sm font-medium uppercase tracking-wider mb-2">Edital de Pesquisa 2024</h3>
            <p className="text-sm text-gray-500">Inscrições até 31/12/2024</p>
            <p className="text-gray-500 text-xs">Valor: R$ 50.000,00</p>
          </div>
          <div className="bg-gray-50 rounded-lg p-6 border border-dashed border-gray-300 hover:bg-white transition-colors">
            <h3 className="text-orange-500 text-sm font-medium uppercase tracking-wider mb-2">Edital de Voluntariado</h3>
            <p className="text-sm text-gray-500">Inscrições abertas</p>
          </div>
          <div className="bg-gray-50 rounded-lg p-6 border border-dashed border-gray-300 hover:bg-white transition-colors">
            <h3 className="text-orange-500 text-sm font-medium uppercase tracking-wider mb-2">Edital de Doação</h3>
            <p className="text-sm text-gray-500">Sua contribuição faz a diferença</p>
          </div>
          <div className="bg-gray-50 rounded-lg p-6 border border-dashed border-gray-300 hover:bg-white transition-colors">
            <h3 className="text-orange-500 text-sm font-medium uppercase tracking-wider mb-2">Edital de Membresia</h3>
            <p className="text-sm text-gray-500">Cadastro de novos membros</p>
          </div>
        </div>
      </section>
    </div>
  </section>
</main>
</Base>